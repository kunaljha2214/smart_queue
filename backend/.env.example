MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
PORT=5500

# SMTP (required for OTP email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_or_smtp_password
SMTP_FROM="Smart Queue <your_email@example.com>"

# Brevo API (recommended for OTP on cloud hosts; avoids SMTP port timeouts)
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=verified_sender@example.com
BREVO_FROM_NAME=Smart Queue

# Razorpay (required for real owner subscription payments)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
